{
  "name": "@musterli/exporters",
  "version": "0.0.0",
  "private": true,
  "description": "SVG/CSS/PNG/JPG/WebP/GIF/MP4/React exporters",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./gif-info": "./src/gif-info.ts",
    "./png-stream": "./src/png-stream.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@musterli/engine": "workspace:*",
    "@musterli/tool-registry": "workspace:*",
    "gifenc": "1.0.3"
  },
  "devDependencies": {
    "@musterli/config": "workspace:*",
    "zod": "^4.6.7"
  }
}

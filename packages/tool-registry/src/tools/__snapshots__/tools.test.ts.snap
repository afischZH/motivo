  "sunset-frame": {
    "css": ".gradient-border {
  border: 6px solid transparent;
  border-radius: 20px;
  background: linear-gradient(#ffffff, #ffffff) padding-box, conic-gradient(from 45deg at 50% 50%, #f59e0b 0%, #f78d00 6.67%, #f87b08 13.33%, #f76920 20%, #f45733 26.67%, #ef4444 33.33%, #f04357 40%, #f14369 46.67%, #f04379 53.33%, #ee4589 60%, #ec4899 66.67%, #f9537c 73.33%, #ff6460 80%, #ff7847 86.67%, #fe8a23 93.33%, #f59e0b 100%) border-box;
  box-shadow: 0px 1px 2px 0px rgb(0 0 0 / 0.054), 0px 8px 24px -4px rgb(0 0 0 / 0.066), 0px 24px 64px -8px rgb(0 0 0 / 0.084);
  color: #431407;
}
",
    "html": "<style>
.stage {
  background-color: #fff7ed;
  background-image: radial-gradient(circle 11px at 28.5px 28.5px, #fdba74 0px 10px, transparent 11px);
  background-size: 57px 57px;
  background-position: 0 0;
  display: grid;
  place-items: center;
  min-height: 100vh;
  margin: 0;
  font-family: system-ui, sans-serif;
}

.gradient-border {
  border: 6px solid transparent;
  border-radius: 20px;
  background: linear-gradient(#ffffff, #ffffff) padding-box, conic-gradient(from 45deg at 50% 50%, #f59e0b 0%, #f78d00 6.67%, #f87b08 13.33%, #f76920 20%, #f45733 26.67%, #ef4444 33.33%, #f04357 40%, #f14369 46.67%, #f04379 53.33%, #ee4589 60%, #ec4899 66.67%, #f9537c 73.33%, #ff6460 80%, #ff7847 86.67%, #fe8a23 93.33%, #f59e0b 100%) border-box;
  box-shadow: 0px 1px 2px 0px rgb(0 0 0 / 0.054), 0px 8px 24px -4px rgb(0 0 0 / 0.066), 0px 24px 64px -8px rgb(0 0 0 / 0.084);
  color: #431407;
}

.gradient-border {
  box-sizing: border-box;
  width: min(600px, 90vw);
  padding: 2rem;
}
</style>
<div class="stage">
  <div class="gradient-border">
    <h2>Card title</h2>
    <p>Some text on the card, to check that it stays readable.</p>
  </div>
</div>
",
    "tailwind": "<div class="[border:6px_solid_transparent] rounded-[20px] [background:linear-gradient(#ffffff,_#ffffff)_padding-box,_conic-gradient(from_45deg_at_50%_50%,_#f59e0b_0%,_#f78d00_6.67%,_#f87b08_13.33%,_#f76920_20%,_#f45733_26.67%,_#ef4444_33.33%,_#f04357_40%,_#f14369_46.67%,_#f04379_53.33%,_#ee4589_60%,_#ec4899_66.67%,_#f9537c_73.33%,_#ff6460_80%,_#ff7847_86.67%,_#fe8a23_93.33%,_#f59e0b_100%)_border-box] shadow-[0px_1px_2px_0px_rgb(0_0_0_/_0.054),_0px_8px_24px_-4px_rgb(0_0_0_/_0.066),_0px_24px_64px_-8px_rgb(0_0_0_/_0.084)] text-[#431407]">
  …
</div>
",

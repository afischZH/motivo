exports[`preset snapshots: css-shadow > extra exports of every preset 1`] = `
{
  "button": {
    "css": "background-color: #4f46e5;
border-radius: 40px;
box-shadow: 0 3px 6px -0.5px rgb(31 30 38 / 0.144),
    0 5.2px 10.4px -0.9px rgb(31 30 38 / 0.109),
    0 6px 12px -1px rgb(31 30 38 / 0.096);
",
    "css-variable": ":root {
  --shadow-button:
    0 3px 6px -0.5px rgb(31 30 38 / 0.144),
    0 5.2px 10.4px -0.9px rgb(31 30 38 / 0.109),
    0 6px 12px -1px rgb(31 30 38 / 0.096);
}

.card {
  box-shadow: var(--shadow-button);
}
",
    "drop-shadow": "/* drop-shadow() has no spread; it is left out. */
filter:
    drop-shadow(0 3px 3px rgb(31 30 38 / 0.144))
    drop-shadow(0 5.2px 5.2px rgb(31 30 38 / 0.109))

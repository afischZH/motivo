  color: #ffffff;
}

.glow-card {
  box-sizing: border-box;
  width: min(480px, 90vw);
  padding: 2rem;
}
</style>
<div class="stage">
  <div class="glow-card">
    <h2>Card title</h2>
    <p>Some text on the card, to check that it stays readable.</p>
  </div>
</div>
",

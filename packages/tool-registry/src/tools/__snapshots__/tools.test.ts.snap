exports[`preset snapshots: glass-effects > extra exports of every preset 1`] = `
{
  "frosted": {
    "css": ".glass-card {
  background-color: #0f172a33;
  -webkit-backdrop-filter: blur(16px) saturate(160%);
  backdrop-filter: blur(16px) saturate(160%);
  border-radius: 24px;
  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35), 0px 1px 2px 0px rgb(0 0 0 / 0.072), 0px 8px 24px -4px rgb(0 0 0 / 0.088), 0px 24px 64px -8px rgb(0 0 0 / 0.112);
  color: #ffffff;
}
",
    "html": "<style>
.stage {
  background-color: #1e1b4b;
  background-image: radial-gradient(circle at 737px 42px, #7c3aed, #7c3aed00 385px), radial-gradient(circle at 1120px 737px, #db2777, #db277700 336px), radial-gradient(circle at 722px 559px, #2563eb, #2563eb00 365px), radial-gradient(circle at 1134px 368px, #7c3aed, #7c3aed00 378px);
  display: grid;
  place-items: center;
  min-height: 100vh;
  margin: 0;
  font-family: system-ui, sans-serif;
}

.glass-card {
  background-color: #0f172a33;
  -webkit-backdrop-filter: blur(16px) saturate(160%);
  backdrop-filter: blur(16px) saturate(160%);
  border-radius: 24px;
  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35), 0px 1px 2px 0px rgb(0 0 0 / 0.072), 0px 8px 24px -4px rgb(0 0 0 / 0.088), 0px 24px 64px -8px rgb(0 0 0 / 0.112);
  color: #ffffff;
}

.glass-card {
  box-sizing: border-box;
  width: min(600px, 90vw);
  padding: 2rem;
}
</style>
<div class="stage">
  <div class="glass-card">
    <h2>Card title</h2>
    <p>Some text on the card, to check that it stays readable.</p>
  </div>
</div>
",

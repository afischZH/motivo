  "neon-ring": {
    "css": "@property --musterli-border-angle {
  syntax: "<angle>";
  inherits: false;
  initial-value: 0deg;
}
@keyframes musterli-border-spin {
  to { --musterli-border-angle: 360deg; }
}

.gradient-border {
  --musterli-border-angle: 0deg;
  border: 3px solid transparent;
  border-radius: 24px;
  background: linear-gradient(#0b1120, #0b1120) padding-box, conic-gradient(from calc(0deg + var(--musterli-border-angle)) at 50% 50%, #22d3ee 0%, #06c2ff 6.67%, #53adff 13.33%, #7097ff 20%, #8b7bff 26.67%, #a855f7 33.33%, #c04ce0 40%, #d444c3 46.67%, #e33ea4 53.33%, #ee3b82 60%, #f43f5e 66.67%, #e65ab6 73.33%, #c47af3 80%, #95a0ff 86.67%, #66bbff 93.33%, #22d3ee 100%) border-box;
  box-shadow: 0px 1px 2px 0px rgb(0 0 0 / 0.108), 0px 8px 24px -4px rgb(0 0 0 / 0.132), 0px 24px 64px -8px rgb(0 0 0 / 0.168);
  color: #ffffff;
  animation: musterli-border-spin 5s linear infinite;
}

@media (prefers-reduced-motion: reduce) {
  .gradient-border {
    animation: none;
  }
}
",
    "html": "<style>
.stage {
  background-color: #020617;
  background-image: repeating-linear-gradient(0deg, #1e293b 0px 3px, transparent 3px 57px), repeating-linear-gradient(90deg, #1e293b 0px 3px, transparent 3px 57px);
  background-size: 100% 100%, 100% 100%;
  background-position: 0 0, 0 0;
  display: grid;
  place-items: center;
  min-height: 100vh;
  margin: 0;
  font-family: system-ui, sans-serif;
}

@property --musterli-border-angle {
  syntax: "<angle>";
  inherits: false;
  initial-value: 0deg;
}
@keyframes musterli-border-spin {
  to { --musterli-border-angle: 360deg; }
}

.gradient-border {
  --musterli-border-angle: 0deg;
  border: 3px solid transparent;
  border-radius: 24px;
  background: linear-gradient(#0b1120, #0b1120) padding-box, conic-gradient(from calc(0deg + var(--musterli-border-angle)) at 50% 50%, #22d3ee 0%, #06c2ff 6.67%, #53adff 13.33%, #7097ff 20%, #8b7bff 26.67%, #a855f7 33.33%, #c04ce0 40%, #d444c3 46.67%, #e33ea4 53.33%, #ee3b82 60%, #f43f5e 66.67%, #e65ab6 73.33%, #c47af3 80%, #95a0ff 86.67%, #66bbff 93.33%, #22d3ee 100%) border-box;
  box-shadow: 0px 1px 2px 0px rgb(0 0 0 / 0.108), 0px 8px 24px -4px rgb(0 0 0 / 0.132), 0px 24px 64px -8px rgb(0 0 0 / 0.168);
  color: #ffffff;
  animation: musterli-border-spin 5s linear infinite;
}

@media (prefers-reduced-motion: reduce) {
  .gradient-border {
    animation: none;
  }
}

.gradient-border {
  box-sizing: border-box;
  width: min(600px, 90vw);
  padding: 2rem;
}
</style>
<div class="stage">
  <div class="gradient-border">
    <h2>Card title</h2>
    <p>Some text on the card, to check that it stays readable.</p>
  </div>
</div>
",

  "violet-glow": {
    "css": ".glow-card {
  background-color: #1e1b4b;
  border: 1px solid rgb(167 139 250 / 0.55);
  border-radius: 12px;
  box-shadow: 0px 0px 19.2px 0px rgb(167 139 250 / 0.54), 0px 0px 57.6px 4.8px rgb(167 139 250 / 0.36), 0px 0px 96px 9.6px rgb(167 139 250 / 0.21);
  color: #ffffff;
}
",
    "html": "<style>
.stage {
  background-color: #0c0a1d;
  background-image: repeating-linear-gradient(0deg, #1e1b4b 0px 3px, transparent 3px 57px), repeating-linear-gradient(90deg, #1e1b4b 0px 3px, transparent 3px 57px);
  background-size: 100% 100%, 100% 100%;
  background-position: 0 0, 0 0;
  display: grid;
  place-items: center;
  min-height: 100vh;
  margin: 0;
  font-family: system-ui, sans-serif;
}

.glow-card {
  background-color: #1e1b4b;
  border: 1px solid rgb(167 139 250 / 0.55);
  border-radius: 12px;

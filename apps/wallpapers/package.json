{
  "name": "@musterli/wallpapers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 3100",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "cf:build": "NEXT_TELEMETRY_DISABLED=1 opennextjs-cloudflare build",
    "cf:preview": "NEXT_TELEMETRY_DISABLED=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "NEXT_TELEMETRY_DISABLED=1 opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@musterli/devices": "workspace:*",
    "@musterli/editor-ui": "workspace:*",
    "@musterli/engine": "workspace:*",
    "@musterli/exporters": "workspace:*",
    "@musterli/tool-registry": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.13",
    "next": "^16.4.3",
    "next-intl": "4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@musterli/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.153.0"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Generic name until the product has a name and domain (decision Andreas
  // 2026-11-04): wallpapers-web.<subdomain>.workers.dev.
  "name": "wallpapers-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // Production on <name>.<subdomain>.workers.dev, every PR its own preview URL.
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
}

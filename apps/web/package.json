{
  "name": "@motivo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/headers.mjs && node scripts/og-images.mjs && NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "node scripts/headers.mjs && node scripts/og-images.mjs && NEXT_TELEMETRY_DISABLED=1 next build",
    "og": "node scripts/og-images.mjs",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude 'e2e/**'",
    "headers:write": "node scripts/headers.mjs",
    "test:e2e": "playwright test",
    "cf:build": "NEXT_TELEMETRY_DISABLED=1 opennextjs-cloudflare build",
    "cf:preview": "NEXT_TELEMETRY_DISABLED=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "NEXT_TELEMETRY_DISABLED=1 opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:upload": "NEXT_TELEMETRY_DISABLED=1 opennextjs-cloudflare build && opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@motivo/db": "workspace:*",
    "@motivo/editor-ui": "workspace:*",
    "@motivo/engine": "workspace:*",
    "@motivo/exporters": "workspace:*",
    "@motivo/svg-sanitizer": "workspace:*",
    "@motivo/tool-registry": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.13",
    "@sentry/browser": "11.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "next": "^16.4.3",
    "next-intl": "4.14.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@motivo/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.153.0"
  }
}

# Environment variables of @motivo/web. Copy to .env.local (next dev/start)
# or .dev.vars (wrangler / cf:preview) and fill in. Never commit real values.
# Every feature below is off while its variable is empty. All of them are
# read at build time and are public (inlined into the browser bundle); the
# app has no server secrets.

# Canonical origin for canonical and hreflang links.
NEXT_PUBLIC_SITE_URL=
# Cloudflare Web Analytics site token (production build only).
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
# Sentry DSN, EU region only (production build only).
NEXT_PUBLIC_SENTRY_DSN=
# Page of the external donation provider, https only (lib/donation.ts).
# Without it, the support page says the donation link follows soon.
NEXT_PUBLIC_DONATION_URL=

# Environment variables of @motivo/web. Copy to .env.local (next dev/start)
# or .dev.vars (wrangler / cf:preview) and fill in. Never commit real values.
# Every feature below is off while its variables are empty.

# --- Build time, public (inlined into the browser bundle) -------------------
# Canonical origin for canonical/hreflang links and links in e-mails.
NEXT_PUBLIC_SITE_URL=
# Cloudflare Web Analytics site token (production build only).
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
# Sentry DSN, EU region only (production build only).
NEXT_PUBLIC_SENTRY_DSN=
# Cloudflare Turnstile site key for the waitlist form. Set together with
# TURNSTILE_SECRET_KEY. Test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Runtime secrets, server only (wrangler secret put <NAME>) ---------------
# Founders waitlist (docs/SETUP-WAITLIST.md). Off unless the first four are set.
SUPABASE_URL=
# Secret key (sb_secret_...) or legacy service_role key. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Sender on a domain verified at Resend, e.g. Motivo <warteliste@example.ch>
WAITLIST_FROM_EMAIL=
# Turnstile secret; without it, sign-ups run without a challenge.
# Test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

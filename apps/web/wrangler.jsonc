{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motivo-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference binding required by OpenNext (https://opennext.js.org/cloudflare/caching)
      "binding": "WORKER_SELF_REFERENCE",
      "service": "motivo-web",
    },
  ],
  "observability": { "enabled": true },
  // Settings for `wrangler preview` (preview builds of non-production branches).
  // Service bindings are not available in previews; the self-reference above is only
  // used for ISR revalidation, which this app does not use yet.
  "previews": {},
}
